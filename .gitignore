# Local secrets — never commit these
.env.local
*.env
secrets/

# Vagrant
vagrant/.vagrant/

# Terraform
**/.terraform/
**/terraform.tfstate
**/terraform.tfstate.backup
**/.terraform.lock.hcl

# kubeconfig backups
*.kubeconfig
kubeconfig

# Helm chart caches
charts/
*.tgz

# MLOps — generated files (tracked by DVC, not Git)
data/
models/
metrics/
mlops/.dvc/cache/
.dvc/cache/
.dvc/tmp/

# Python virtualenvs
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# DVC internals (init files are committed, runtime files are not)
.dvc/tmp/
.dvc/cache/
mlops/dvc.lock

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo
